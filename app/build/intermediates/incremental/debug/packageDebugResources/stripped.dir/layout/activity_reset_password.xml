<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include android:id="@+id/header" layout="@layout/header_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reset your password"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Enter the email on your account and we'll send a reset link."
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="18dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Email" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
        <EditText android:id="@+id/etEmail" style="@style/Amplify.EditText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="you@example.com" android:inputType="textEmailAddress" android:layout_marginBottom="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSendReset"
            style="@style/Amplify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send reset link" />

    </LinearLayout>
</LinearLayout>
