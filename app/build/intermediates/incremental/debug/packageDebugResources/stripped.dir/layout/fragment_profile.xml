<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_settings"
            android:padding="8dp"
            android:contentDescription="Settings" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="AB"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="20sp"
                    android:layout_marginBottom="10dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Atiyyah Bata"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Software Engineering student"
                    android:textSize="12.5sp"
                    android:textColor="@color/muted"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="10dp"
                        android:src="@drawable/ic_verified_mark"
                        android:layout_marginEnd="4dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Verified"
                        android:textSize="12sp"
                        android:textColor="@color/teal"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGithub"
                    style="@style/Amplify.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12.5sp"
                    android:text="GitHub ↗" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedIn"
                    style="@style/Amplify.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12.5sp"
                    android:text="LinkedIn ↗" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your posts"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_marginBottom="8dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardMyPost"
                style="@style/Amplify.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Setting up a CI pipeline for a student project"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="14 messages started from this post"
                        android:textSize="12sp"
                        android:textColor="@color/muted"
                        android:layout_marginTop="3dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/teal_soft"
                android:textColor="@color/teal"
                app:cornerRadius="28dp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:text="Verification status" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
