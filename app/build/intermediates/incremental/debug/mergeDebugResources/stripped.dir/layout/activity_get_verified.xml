<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include android:id="@+id/header" layout="@layout/header_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Upload proof of qualification (a certificate or degree) so the community knows your posts are from a real practitioner."
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:lineSpacingMultiplier="1.3"
            android:layout_marginBottom="16dp" />

        <LinearLayout
            android:id="@+id/uploadBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_upload_box"
            android:padding="26dp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="18dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_upload"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvUploadLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to upload a certificate"
                android:textSize="13sp"
                android:textColor="@color/muted" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmit"
            style="@style/Amplify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Submit for verification"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:text="Status: Verified · reviewed by an admin on 12 Aug 2026" />

    </LinearLayout>
</LinearLayout>
