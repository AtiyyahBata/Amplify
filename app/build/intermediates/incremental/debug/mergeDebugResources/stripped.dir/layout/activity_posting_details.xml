<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include android:id="@+id/header" layout="@layout/header_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Check how this will look before it goes live."
            android:textSize="13sp"
            android:textColor="@color/muted"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Amplify.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_avatar_circle"
                        android:gravity="center"
                        android:text="AB"
                        android:textColor="@color/accent"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:layout_marginEnd="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Atiyyah Bata"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your post title appears here"
                    android:textSize="14.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Your post body preview will render here, exactly as the community will see it."
                    android:textSize="13sp"
                    android:textColor="@color/muted"
                    android:layout_marginTop="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Visibility" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />

        <Spinner
            android:id="@+id/spinnerVisibility"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:background="@drawable/bg_input_field"
            android:padding="10dp"
            android:layout_marginBottom="18dp"
            android:entries="@array/visibility_options" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPublish"
            style="@style/Amplify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Publish" />

    </LinearLayout>
</LinearLayout>
