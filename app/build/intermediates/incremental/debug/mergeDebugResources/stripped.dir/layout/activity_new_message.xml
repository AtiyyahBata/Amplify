<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include android:id="@+id/header" layout="@layout/header_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="To" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
        <EditText android:id="@+id/etRecipient" style="@style/Amplify.EditText"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Search a username" android:layout_marginBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Message" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
        <EditText android:id="@+id/etMessageBody" style="@style/Amplify.EditText"
            android:layout_width="match_parent" android:layout_height="120dp"
            android:hint="Write your message..." android:gravity="top|start"
            android:inputType="textMultiLine" android:layout_marginBottom="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSend"
            style="@style/Amplify.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Send" />

    </LinearLayout>
</LinearLayout>
