<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="New post"
        android:textSize="17sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:layout_marginBottom="4dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Share something the community can learn from."
        android:textSize="13sp"
        android:textColor="@color/muted"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:layout_marginBottom="14dp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Title" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
            <EditText android:id="@+id/etTitle" style="@style/Amplify.EditText"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:hint="What are you sharing?" android:layout_marginBottom="12dp" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Format" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
            <Spinner
                android:id="@+id/spinnerFormat"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:background="@drawable/bg_input_field"
                android:layout_marginBottom="12dp"
                android:padding="10dp"
                android:entries="@array/post_formats" />

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Body" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
            <EditText android:id="@+id/etBody" style="@style/Amplify.EditText"
                android:layout_width="match_parent" android:layout_height="120dp"
                android:hint="Write or paste your content here..." android:gravity="top|start"
                android:inputType="textMultiLine" android:layout_marginBottom="18dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                style="@style/Amplify.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Continue"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>
</LinearLayout>
