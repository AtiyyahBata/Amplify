<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string-array name="post_formats">
        <item>Blog / article</item>
        <item>Video</item>
        <item>Quick tip</item>
    </string-array>
    <string-array name="visibility_options">
        <item>Public — visible to everyone</item>
        <item>Followers only</item>
    </string-array>
    <color name="accent">#5B4FE0</color>
    <color name="accent_soft">#EFEDFC</color>
    <color name="coral">#E85D4C</color>
    <color name="coral_soft">#FDECEA</color>
    <color name="ink">#12141C</color>
    <color name="ink_soft">#2A2E3A</color>
    <color name="line">#DCDFE6</color>
    <color name="line_soft">#E7E9EF</color>
    <color name="muted">#6B7080</color>
    <color name="paper">#EEF0F4</color>
    <color name="surface">#FFFFFF</color>
    <color name="teal">#1B8F82</color>
    <color name="teal_soft">#E4F4F1</color>
    <color name="white">#FFFFFF</color>
    <string name="ai_assistant_title">AI Assistant</string>
    <string name="ai_chip_explain">Explain something</string>
    <string name="ai_chip_ideas">Give me ideas</string>
    <string name="ai_chip_summarize">Summarize this post</string>
    <string name="ai_hello">Hello!</string>
    <string name="ai_input_placeholder">Type your message…</string>
    <string name="ai_prompt_subtitle">Ask me anything.\nI\'m here to help!</string>
    <string name="app_name">Amplify</string>
    <string name="cd_back">Back</string>
    <string name="cd_history">History</string>
    <string name="cd_more_options">More options</string>
    <string name="cd_send_message">Send message</string>
    <string name="tagline">A career companion for software engineering students — resources, real people, and an AI search that points you to sources instead of answers.</string>
    <style name="Amplify.Button.Outline" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/line</item>
        <item name="android:textColor">@color/ink</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Amplify.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/accent</item>
        <item name="cornerRadius">28dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>
    <style name="Amplify.Button.Text" parent="Widget.MaterialComponents.Button.TextButton">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="Amplify.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/line_soft</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardBackgroundColor">@color/surface</item>
    </style>
    <style name="Amplify.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input_field</item>
        <item name="android:padding">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColorHint">@color/muted</item>
    </style>
    <style name="Amplify.Tag" parent="">
        <item name="android:background">@drawable/bg_tag</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">monospace</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>
    <style name="Theme.Amplify" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/ink</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>