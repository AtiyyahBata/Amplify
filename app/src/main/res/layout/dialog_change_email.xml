<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="12dp">

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="New email" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
    <EditText android:id="@+id/etNewEmail" style="@style/Amplify.EditText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="you@example.com" android:inputType="textEmailAddress" android:layout_marginBottom="14dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Your password" android:textSize="12sp" android:textStyle="bold" android:textColor="@color/muted" android:layout_marginBottom="5dp" />
    <EditText android:id="@+id/etPassword" style="@style/Amplify.EditText"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:inputType="textPassword" android:layout_marginBottom="8dp" />

    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="We'll email a confirmation link. Your email changes after you open it."
        android:textSize="12sp" android:textColor="@color/muted" />

</LinearLayout>
