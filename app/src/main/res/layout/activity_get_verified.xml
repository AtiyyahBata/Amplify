<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:orientation="vertical">

    <include android:id="@+id/header" layout="@layout/header_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Upload proof of qualification (a certificate or degree) so the community knows your posts are from a real practitioner."
                android:textSize="13sp"
                android:textColor="@color/muted"
                android:lineSpacingMultiplier="1.3"
                android:layout_marginBottom="16dp" />

            <ProgressBar
                android:id="@+id/progress"
                style="?android:attr/progressBarStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp" />

            <!-- Shows: waiting, not approved, verified, or a load error -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStatus"
                style="@style/Amplify.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvStatusTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tvStatusDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textSize="13sp"
                        android:textColor="@color/muted"
                        android:lineSpacingMultiplier="1.25" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- The application form (hidden while waiting, verified or blocked) -->
            <LinearLayout
                android:id="@+id/formGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="University you studied at or study at"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etUniversity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="e.g. Eduvos"
                    android:textColorHint="@color/muted"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:inputType="textCapWords"
                    android:maxLength="120"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Why do you want to be verified?"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etReason"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input_field"
                    android:hint="Tell the admins a little about yourself"
                    android:textColorHint="@color/muted"
                    android:textColor="@color/ink"
                    android:textSize="14sp"
                    android:inputType="textMultiLine|textCapSentences"
                    android:gravity="top|start"
                    android:minLines="4"
                    android:maxLength="500"
                    android:padding="14dp"
                    android:layout_marginBottom="14dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photo of your certificate or degree"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/ink"
                    android:layout_marginBottom="6dp" />

                <LinearLayout
                    android:id="@+id/uploadBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:background="@drawable/bg_upload_box"
                    android:padding="26dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:layout_marginBottom="18dp">

                    <ImageView
                        android:id="@+id/ivUploadIcon"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:src="@drawable/ic_upload"
                        android:layout_marginBottom="8dp" />

                    <ImageView
                        android:id="@+id/ivCertificatePreview"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:adjustViewBounds="true"
                        android:maxHeight="220dp"
                        android:scaleType="fitCenter"
                        android:layout_marginBottom="10dp"
                        android:visibility="gone"
                        android:contentDescription="Selected certificate" />

                    <TextView
                        android:id="@+id/tvUploadLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tap to upload a photo (JPG, PNG or WebP)"
                        android:textSize="13sp"
                        android:textColor="@color/muted" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSubmit"
                    style="@style/Amplify.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Submit for verification" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
