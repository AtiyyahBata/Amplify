<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Profile"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/ink" />

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_settings"
            android:padding="8dp"
            android:contentDescription="Settings" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollProfile"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Header: avatar on the left, details on the right -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="16dp">

                <TextView
                    android:id="@+id/tvProfileInitials"
                    android:layout_width="80dp"
                    android:layout_height="80dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:text="AB"
                    android:textColor="@color/accent"
                    android:textStyle="bold"
                    android:textSize="26sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvProfileName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Loading profile..."
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/ink" />

                    <TextView
                        android:id="@+id/tvFieldOfStudy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Loading field of study..."
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:textSize="13sp"
                        android:textColor="@color/muted" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_verified_chip"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingStart="10dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp">

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="10dp"
                            android:src="@drawable/ic_verified_mark"
                            android:layout_marginEnd="5dp"
                            android:contentDescription="Verification status" />

                        <TextView
                            android:id="@+id/tvVerificationLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Checking status..."
                            android:textSize="12sp"
                            android:textColor="@color/teal"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnGithub"
                    style="@style/Amplify.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12.5sp"
                    android:text="GitHub ↗" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLinkedIn"
                    style="@style/Amplify.Button.Outline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:paddingTop="8dp"
                    android:paddingBottom="8dp"
                    android:textSize="12.5sp"
                    android:text="LinkedIn ↗" />
            </LinearLayout>

            <!-- Only shown when the user is NOT verified (ProfileFragment turns it on).
                 Sits above the posts so an unverified user actually sees it. -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnVerificationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:backgroundTint="@color/teal_soft"
                android:textColor="@color/teal"
                app:cornerRadius="28dp"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:text="Get verified"
                android:visibility="gone" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your posts"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/ink"
                android:layout_marginTop="22dp"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvNoMyPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="You haven't posted anything yet."
                android:textSize="12.5sp"
                android:textColor="@color/muted"
                android:paddingTop="6dp"
                android:paddingBottom="14dp"
                android:visibility="gone" />

            <!-- Vertical list of posts. The page around it does the scrolling. -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMyPosts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                android:clipToPadding="false" />

            <ProgressBar
                android:id="@+id/progressMore"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
