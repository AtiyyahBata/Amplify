<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="20dp"
    android:paddingEnd="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:layout_width="20dp"
        android:layout_height="15dp"
        android:src="@drawable/ic_logo_mark"
        android:layout_marginEnd="8dp"
        android:contentDescription="Brand Logo" />

    <TextView
        android:id="@+id/tvBrandTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="Amplify"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/ink" />

    <!-- Top Right AI Robot Icon Button -->
    <FrameLayout
        android:id="@+id/btnHeaderAiRobot"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_ai_floating_button"
        android:clickable="true"
        android:focusable="true">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center"
            android:src="@drawable/lexi_logo"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:importantForAccessibility="no" />
    </FrameLayout>

</LinearLayout>
