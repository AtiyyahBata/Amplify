<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F9FE"
    android:gravity="center"
    android:padding="24dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_history_clock"
        app:tint="@color/accent"
        android:layout_marginBottom="24dp"
        android:contentDescription="@null" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Delete All Chat History?"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/ink"
        android:layout_marginBottom="12dp"
        android:gravity="center" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="This will permanently delete all your AI chat conversations and history stored in Supabase. This action cannot be undone."
        android:textSize="14sp"
        android:textColor="@color/muted"
        android:gravity="center"
        android:lineSpacingMultiplier="1.2"
        android:layout_marginBottom="32dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDeleteAll"
        style="@style/Widget.MaterialComponents.Button"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Delete All Chats"
        android:backgroundTint="#D32F2F"
        android:textColor="@color/white"
        android:textStyle="bold"
        android:layout_marginBottom="12dp"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCancel"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Cancel"
        android:textColor="@color/ink"
        app:cornerRadius="12dp" />

</LinearLayout>
