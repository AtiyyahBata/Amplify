<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/paper"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp">

        <!-- Illustration and overlapping welcome panel -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Top illustration -->
            <ImageView
                android:id="@+id/imgWelcomeIllustration"
                android:layout_width="match_parent"
                android:layout_height="460dp"
                android:contentDescription="Amplify technology learning and career community"
                android:scaleType="fitXY"
                android:src="@drawable/amplify_welcome_illustration" />


            <!-- Curved panel overlapping the illustration -->
            <LinearLayout
                android:id="@+id/welcomePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="420dp"
                android:background="@drawable/bg_welcome_panel"
                android:elevation="8dp"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:paddingTop="32dp"
                android:paddingBottom="24dp">

                <!-- Small label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_welcome_badge"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:text="YOUR CAREER COMPANION"
                    android:textColor="@color/accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Main heading -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:text="Build your future in tech"
                    android:textColor="@color/ink"
                    android:textSize="25sp"
                    android:textStyle="bold" />

                <!-- Welcome description -->
                <TextView
                    android:id="@+id/txtWelcomeDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="24dp"
                    android:gravity="center"
                    android:lineSpacingExtra="3dp"
                    android:text="A career companion for software engineering students — resources, real people, and an AI search that points you to sources instead of answers."
                    android:textColor="#626779"
                    android:textSize="14sp" />

                <!-- Log in button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogIn"
                    style="@style/Amplify.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Log in" />

                <!-- Create an account button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    style="@style/Amplify.Button.Outline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Create an account" />

                <!-- Divider above admin access -->
                <View
                    android:layout_width="48dp"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:background="#D7D9E3" />

                <!-- Admin portal link -->
                <LinearLayout
                    android:id="@+id/btnAdminLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_admin_shield"
                        android:contentDescription="@null"
                        app:tint="@color/accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Admin portal"
                        android:textColor="@color/accent"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>

        </FrameLayout>

    </LinearLayout>

</ScrollView>
